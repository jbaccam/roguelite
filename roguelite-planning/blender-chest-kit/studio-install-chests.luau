-- Installs the chest kit after ONE Studio 3D Import of exports/fbx/chest-kit-studio.fbx
-- (default settings). Builds ReplicatedStorage.ChestModels.<Tier> templates used by the chest
-- island (studio-prototype/lobby/InstallChestIsland.luau) and the chest screen (ChestFX).
--
-- Each template: pivot = ground centre, front = pivot LookVector (-Z). Parts keep their Blender
-- names (Chest_Base, Chest_Lid, ...) and get attribute Kind (textured|glow|floor|accent);
-- lid parts get Lid=true. Model attributes: Tier, Hinge (CFrame in pivot space), OpenDeg.
-- Textured parts use MeshPart.TextureID (a SurfaceAppearance from the importer is converted;
-- see memory: SurfaceAppearance can render blank in Play). Glow parts become Neon.
--
-- Generated by package_studio.py data (studio-install-data.json, Studio axes = (-x, z, y) of Blender).
-- Set ONLY to one tier name (e.g. "Magical") to re-install just that tier after re-importing it.
local ONLY = nil
local RS = game:GetService("ReplicatedStorage")
local DATA = {
  Wooden={hinge=Vector3.new(-0.0,2.95,2.33),openDeg=105.0,moves={"Chest_Lid"},parts={
   Chest_Lid={kind="textured",center=Vector3.new(-0.0,4.1656,-0.02),size=Vector3.new(6.26,2.4311,4.94)},
   Chest_Inner={kind="floor",center=Vector3.new(-0.0,1.95,0.0),size=Vector3.new(5.38,0.04,3.78)},
   Chest_Glow={kind="glow",center=Vector3.new(-0.0,2.795,-0.33),size=Vector3.new(5.88,0.49,4.94)},
   Chest_Base={kind="textured",center=Vector3.new(-0.0,1.86,-0.165),size=Vector3.new(6.5,3.72,5.23)},
  }},
  Silver={hinge=Vector3.new(-0.0,3.09,2.44),openDeg=105.0,moves={"Chest_Lid"},parts={
   Chest_Lid={kind="textured",center=Vector3.new(-0.0,4.4147,-0.0),size=Vector3.new(6.9,2.6494,5.32)},
   Chest_Inner={kind="floor",center=Vector3.new(-0.0,2.07,0.0),size=Vector3.new(5.62,0.04,3.96)},
   Chest_Glow={kind="glow",center=Vector3.new(-0.0,2.735,-0.3625),size=Vector3.new(6.12,0.77,5.185)},
   Chest_Base={kind="textured",center=Vector3.new(-0.0,2.01,-0.185),size=Vector3.new(7.3,4.02,6.01)},
  }},
  Gold={hinge=Vector3.new(-0.0,3.24,2.49),openDeg=105.0,moves={"Chest_Lid"},parts={
   Chest_Lid={kind="textured",center=Vector3.new(-0.0,4.6871,-0.0),size=Vector3.new(7.0,2.9343,5.47)},
   Chest_Inner={kind="floor",center=Vector3.new(-0.0,2.66,0.0),size=Vector3.new(5.72,0.98,4.02)},
   Chest_Glow={kind="glow",center=Vector3.new(-0.0,2.82,-0.3625),size=Vector3.new(6.28,0.9,5.305)},
   Chest_Base={kind="textured",center=Vector3.new(-0.0,1.9664,-0.1329),size=Vector3.new(7.718,3.9329,6.2343)},
  }},
  Magical={hinge=Vector3.new(-0.0,4.13,2.23),openDeg=102.0,moves={"Chest_Lid","Chest_LidSkull","Chest_LidMagic"},parts={
   Chest_Magic={kind="accent",center=Vector3.new(-0.0,3.1474,-0.3482),size=Vector3.new(7.48,2.7268,5.0164)},
   Chest_LidSkull={kind="textured",center=Vector3.new(-0.0235,6.7069,-1.4852),size=Vector3.new(2.7446,2.9972,2.9751)},
   Chest_LidMagic={kind="accent",center=Vector3.new(-0.0,5.6903,0.0),size=Vector3.new(6.4,1.6793,4.0079)},
   Chest_Lid={kind="textured",center=Vector3.new(0.0169,6.4445,-0.0204),size=Vector3.new(11.3523,4.531,5.6041)},
   Chest_Inner={kind="floor",center=Vector3.new(-0.0,3.39,0.0),size=Vector3.new(4.8,0.58,3.8)},
   Chest_Glow={kind="glow",center=Vector3.new(-0.0,4.13,0.0),size=Vector3.new(6.44,0.16,4.28)},
   Chest_Base={kind="textured",center=Vector3.new(0.0127,2.4783,-0.0045),size=Vector3.new(7.6358,4.9567,5.81)},
  }},
  Legendary={hinge=Vector3.new(-0.0,3.9,2.86),openDeg=105.0,moves={"Chest_Lid","Chest_Lid_Jewel"},parts={
   Chest_Lid_Jewel={kind="accent",center=Vector3.new(-0.0,6.3024,-2.508),size=Vector3.new(0.3903,0.3174,0.2671)},
   Chest_Lid={kind="textured",center=Vector3.new(-0.0,5.6781,0.0),size=Vector3.new(7.88,3.5561,6.24)},
   Chest_Jewel={kind="accent",center=Vector3.new(-0.0,3.87,-3.7925),size=Vector3.new(0.4582,0.4582,0.025)},
   Chest_Inner={kind="floor",center=Vector3.new(-0.0,3.605,0.0),size=Vector3.new(6.64,2.07,4.64)},
   Chest_Glow={kind="glow",center=Vector3.new(-0.0,3.42,-0.2775),size=Vector3.new(7.72,0.98,6.275)},
   Chest_Base={kind="textured",center=Vector3.new(-0.0,2.877,-0.0499),size=Vector3.new(9.793,5.7516,7.8928)},
  }},
}
-- Neon colours per tier (ChestConfig glow / accent).
local Chests = require(RS.RogueliteCombat.ChestConfig)

local folder = RS:FindFirstChild("ChestModels") or Instance.new("Folder")
folder.Name = "ChestModels"
folder.Parent = RS
local report = {}

-- Every imported part named <Tier>_<Part>, wherever the importer put it. Already-installed
-- templates are picked up too, so re-running the installer repairs them in place.
local found = {}
for _, d in workspace:GetDescendants() do
	if d:IsA("MeshPart") then
		local tier, part = string.match(d.Name, "^(%a+)_(Chest_.+)$")
		if tier and DATA[tier] and DATA[tier].parts[part] then
			found[tier] = found[tier] or {}
			found[tier][part] = d
		end
	end
end
for _, m in folder:GetChildren() do
	if DATA[m.Name] and not found[m.Name] then
		found[m.Name] = {}
		for _, d in m:GetChildren() do
			if d:IsA("MeshPart") and DATA[m.Name].parts[d.Name] then
				found[m.Name][d.Name] = d
			end
		end
	end
end
-- The importer may turn the file (it laid it on its back on 2026-09-28): try every
-- 90-degree turn and keep the one whose part layout matches the Blender export best.
local TURNS = {}
for _, rx in { 0, 90, 180, 270 } do
	for _, ry in { 0, 90, 180, 270 } do
		for _, rz in { 0, 90, 270 } do
			table.insert(TURNS, CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz)))
		end
	end
end

for tier, t in DATA do
	if ONLY and tier ~= ONLY then
		continue
	end
	local parts = found[tier]
	local base = parts and parts.Chest_Base
	if not base then
		table.insert(report, tier .. ": not imported")
		continue
	end
	-- Importer unit handling varies; restore authored studs (largest side vs largest side).
	local want = t.parts.Chest_Base.size
	local got = base.Size
	local factor = math.max(got.X, got.Y, got.Z) / math.max(want.X, want.Y, want.Z)
	-- Orientation: the 90-degree turn that best maps every part's offset from the base.
	local R, best = CFrame.identity, math.huge
	for _, turn in TURNS do
		local err = 0
		for name, p in parts do
			local o = (t.parts[name].center - t.parts.Chest_Base.center) * factor
			err += ((p.Position - base.Position) - turn:VectorToWorldSpace(o)).Magnitude
		end
		if err < best - 1e-3 then
			R, best = turn, err
		end
	end
	local origin = base.Position - R:VectorToWorldSpace(t.parts.Chest_Base.center * factor)
	local pivot = CFrame.new(origin) * R
	local old = folder:FindFirstChild(tier)
	if old then
		for _, p in parts do
			p.Parent = nil -- keep the parts when repairing an installed template
		end
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = tier
	local def = Chests.ById[tier]
	for name, p in parts do
		local info = t.parts[name]
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = name == "Chest_Base"
		p.Locked = true
		p:SetAttribute("Kind", info.kind)
		if table.find(t.moves, name) then
			p:SetAttribute("Lid", true)
		end
		local sa = p:FindFirstChildOfClass("SurfaceAppearance")
		if info.kind == "textured" then
			if sa then
				p.TextureID = sa.ColorMap
				sa:Destroy()
			end
			p.Material = Enum.Material.SmoothPlastic
			p.Color = Color3.new(1, 1, 1)
			p.CastShadow = true
		else
			if sa then
				sa:Destroy()
			end
			p.TextureID = ""
			p.Material = Enum.Material.Neon
			p.CastShadow = false
			p.Color = (info.kind == "accent" and def.accent) or def.glow
		end
		p.Parent = model
	end
	-- With a PrimaryPart the pivot is PrimaryPart.CFrame * PivotOffset (WorldPivot is ignored).
	model.PrimaryPart = parts.Chest_Base
	parts.Chest_Base.PivotOffset = parts.Chest_Base.CFrame:ToObjectSpace(pivot)
	if math.abs(factor - 1) > 0.01 then
		model:ScaleTo(1 / factor)
	end
	model:SetAttribute("Tier", tier)
	model:SetAttribute("Hinge", CFrame.new(t.hinge))
	model:SetAttribute("OpenDeg", t.openDeg)
	model:SetAttribute("SourceFbx", "roguelite-planning/blender-chest-kit/exports/fbx/chest-kit-studio.fbx")
	model:PivotTo(CFrame.new())
	model.Parent = folder
	local n = 0
	for _ in parts do
		n += 1
	end
	local rx, ry, rz = R:ToEulerAnglesXYZ()
	table.insert(report, string.format("%s: %d parts, scale fix %.3f, turn (%d,%d,%d), fit error %.3f", tier, n, factor, math.deg(rx), math.deg(ry), math.deg(rz), best))
end
-- Remove the emptied import shell (the importer names its root after the file).
for _, c in workspace:GetChildren() do
	if string.find(string.lower(c.Name), "chest%-kit") and not c:FindFirstChildWhichIsA("BasePart", true) then
		c:Destroy()
	end
end
table.sort(report)
return table.concat(report, "\n")
