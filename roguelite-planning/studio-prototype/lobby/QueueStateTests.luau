-- Pure deterministic regression checks. No services, instances, saves or rewards.
-- Usage: load the current QueueState and call QueueStateTests.run(QueueState).
local T={}
function T.run(Q)
 local checks=0
 local function check(ok,message) checks+=1;assert(ok,message) end
 local s=Q.new(4,4)
 check(s:join(1,1,0),'Host joins')
 check(s:join(2,1,0),'Member joins')
 check(not s:lockIn(2,1),'A member cannot consent before a map is chosen')
 check(not s:start(2,1,1,'PineValley',false,'Normal'),'A member cannot select the host map')
 check(s:start(1,1,2,'PineValley',false,'Normal'),'Host starts ready check')
 check(s.queues[1].picked[1] and not s.queues[1].picked[2],'Only the host has confirmed')
 check(s.queues[1].launchAt==nil,'Unready member suppresses countdown')
 check(#s:due(3600)==0,'One hour never substitutes for member consent')
 check(s:lockIn(2,3601),'Member readies')
 check(s.queues[1].launchAt==3611,'Partial open queue waits ten seconds after final ready')
 check(s:unready(1,3602),'Host can unready')
 check(s.queues[1].launchAt==nil and #s:due(7200)==0,'Unready cancels countdown')
 check(s:lockIn(1,7201),'Host readies again')
 check(s:join(3,1,7202),'Late join accepted')
 check(s.queues[1].launchAt==nil,'Late join cancels countdown')
 check(s:picking(1)==1,'Late join is shown as unready')
 check(s:leave(3,7203),'Late join can leave')
 check(s.queues[1].launchAt==7213,'After late join leaves, restart full countdown')
 check(#s:due(7212)==0,'Do not launch a second early')
 check(#s:due(7213)==1,'Everyone ready: launch once')
 check(#s:due(7214)==0,'Already locked queue does not launch twice')
 check(not s:unready(1,7214),'Cannot change readiness after departure lock')
 s:cancelLaunch(1,7215)
 check(not s.queues[1].locked and s:picking(1)==2,'Failed final validation resets both confirmations')
 check(#s:due(9000)==0,'Failure never falls through to a partial launch')
 check(s:leave(1,9001) and s.queues[1].host==2,'Host departure transfers host')
 check(s:leave(2,9002) and s.queues[1].phase=='Idle','Last departure resets portal')
 check(s:join(4,1,0),'Private host joins')
 check(s:start(4,1,0,'PineValley',true,'Normal',{[4]=true,[5]=true}),'Start private party')
 check(not s:join(6,1,1),'Uninvited player cannot join private party')
 check(s:join(5,1,1),'Invited player joins private party')
 check(s.queues[1].launchAt==nil and #s:due(100)==0,'Private party also waits indefinitely')
 check(s:lockIn(5,101) and s.queues[1].launchAt==104,'Full private party gets three seconds')
 check(s:unready(5,103) and #s:due(104)==0,'Last-second unready blocks launch')
 check(s:lockIn(5,105) and s.queues[1].launchAt==108,'Re-ready restarts three seconds')
 check(#s:due(108)==1,'Private launch when everyone ready')
 s:finish(1)
 check(s.membership[4]==nil and s.membership[5]==nil,'Finish clears every membership')
 check(s.queues[1].launchAt==nil and s:picking(1)==0,'Finish clears readiness/countdown')
 -- Pick deadlines (2026-10-16): a timeout removes whoever holds the pad and never launches them.
 local M,R,C=Q.MAP_LIMIT,Q.READY_LIMIT,Q.COUNTDOWN
 local d=Q.new(2,4)
 check(d:join(10,1,100) and d:join(11,1,105),'Host and member take a pad')
 local at,kind=d:deadline(10);check(at==100+M and kind=='Map','Host must START within MAP_LIMIT of taking the pad')
 at,kind=d:deadline(11);check(at==100+M and kind=='Host','A member waiting sees the host deadline')
 check(#d:expire(100+M-1)==0,'Nobody is removed a second early')
 local gone=d:expire(100+M)
 check(#gone==2 and gone[1].id==10 and gone[1].reason=='Map' and gone[2].id==11 and gone[2].reason=='Host','Host with no map: the whole pad empties')
 check(d.membership[10]==nil and d.membership[11]==nil and d.queues[1].phase=='Idle' and d:freePad()==1,'The pad is free for other players')
 check(d:join(20,1,200) and d:join(21,1,201) and d:join(22,1,202),'Three on a pad')
 check(d:start(20,1,210,'PineValley',false,'Normal'),'Host starts at 210')
 check(d:deadline(20)==nil,'START readies the host: no deadline')
 at,kind=d:deadline(21);check(at==210+R and kind=='Class','Members get READY_LIMIT from the map, not from joining')
 check(d:lockIn(21,220) and d:deadline(21)==nil,'A member who readies has no deadline')
 check(d:join(23,1,230) and d:deadline(23)==230+R,'A late join gets its own clock')
 check(d:unready(23,231) and d:deadline(23)==230+R,'Changing an unready pick does not extend it')
 check(#d:expire(210+R-1)==0,'Still in time')
 gone=d:expire(210+R)
 check(#gone==1 and gone[1].id==22 and gone[1].reason=='Class' and gone[1].index==1,'Only the member still picking is removed')
 check(d.membership[20]==1 and d.membership[21]==1 and d.membership[23]==1,'Ready players and the late join stay')
 check(d.queues[1].launchAt==nil and #d:due(10^6)==0,'The late join still picking holds the countdown')
 check(d:unready(21,235) and d:deadline(21)==235+R,'UNREADY starts a fresh clock')
 check(d:lockIn(21,236),'Re-ready')
 gone=d:expire(230+R)
 check(#gone==1 and gone[1].id==23,'The late join is removed at its own deadline')
 check(d.queues[1].launchAt==230+R+C,'Everyone left is ready: the normal countdown starts')
 check(#d:expire(230+R+C)==0 and #d:due(230+R+C)==1,'Ready players launch, nobody else removed')
 check(#d:expire(10^6)==0,'A departing (locked) pad never expires')
 d:finish(1)
 check(d:join(30,2,0) and d:join(31,2,0) and d:start(30,2,1,'PineValley',false,'Normal'),'Second pad starts')
 check(d:lockIn(31,2) and d:unready(30,5),'Member ready, host unreadies')
 gone=d:expire(5+R)
 check(#gone==1 and gone[1].id==30 and gone[1].reason=='Class' and d.queues[2].host==31,'An unready host is removed like anyone; the ready member hosts')
 check(d.queues[2].phase=='Counting' and d.queues[2].launchAt==5+R+C,'The map stays and the ready member counts down')
 d:finish(2)
 check(d:join(40,2,0) and d:join(41,2,0) and d:start(40,2,0,'PineValley',false,'Normal') and d:lockIn(41,1),'Both ready')
 check(#d:due(C+1)==1,'Launch locks')
 d:cancelLaunch(2,50)
 check(d:deadline(40)==50+R and d:deadline(41)==50+R,'A failed launch gives everyone a fresh READY_LIMIT')
 d:finish(2)
 check(d:join(50,2,0) and d:start(50,2,0,'PineValley',true,'Normal',{}) and d:deadline(50)==nil,'Solo private: START readies, nothing to expire')
 check(#d:expire(10^6)==0 and d.membership[50]==2,'Solo host is never removed while counting down')
 return {passed=checks,failed=0}
end
return T
