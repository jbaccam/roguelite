-- Pure deterministic regression checks. No services, instances, saves or rewards.
-- Usage: load the current QueueState and call QueueStateTests.run(QueueState).
local T={}
function T.run(Q)
 local checks=0
 local function check(ok,message) checks+=1;assert(ok,message) end
 local s=Q.new(4,4)
 check(s:join(1,1,0),'Host joins')
 check(s:join(2,1,0),'Member joins')
 check(not s:lockIn(2,1),'A member cannot consent before a map is chosen')
 check(not s:start(2,1,1,'PineValley',false,'Normal'),'A member cannot select the host map')
 check(s:start(1,1,2,'PineValley',false,'Normal'),'Host starts ready check')
 check(s.queues[1].picked[1] and not s.queues[1].picked[2],'Only the host has confirmed')
 check(s.queues[1].launchAt==nil,'Unready member suppresses countdown')
 check(#s:due(3600)==0,'One hour never substitutes for member consent')
 check(s:lockIn(2,3601),'Member readies')
 check(s.queues[1].launchAt==3611,'Partial open queue waits ten seconds after final ready')
 check(s:unready(1,3602),'Host can unready')
 check(s.queues[1].launchAt==nil and #s:due(7200)==0,'Unready cancels countdown')
 check(s:lockIn(1,7201),'Host readies again')
 check(s:join(3,1,7202),'Late join accepted')
 check(s.queues[1].launchAt==nil,'Late join cancels countdown')
 check(s:picking(1)==1,'Late join is shown as unready')
 check(s:leave(3,7203),'Late join can leave')
 check(s.queues[1].launchAt==7213,'After late join leaves, restart full countdown')
 check(#s:due(7212)==0,'Do not launch a second early')
 check(#s:due(7213)==1,'Everyone ready: launch once')
 check(#s:due(7214)==0,'Already locked queue does not launch twice')
 check(not s:unready(1,7214),'Cannot change readiness after departure lock')
 s:cancelLaunch(1,7215)
 check(not s.queues[1].locked and s:picking(1)==2,'Failed final validation resets both confirmations')
 check(#s:due(9000)==0,'Failure never falls through to a partial launch')
 check(s:leave(1,9001) and s.queues[1].host==2,'Host departure transfers host')
 check(s:leave(2,9002) and s.queues[1].phase=='Idle','Last departure resets portal')
 check(s:join(4,1,0),'Private host joins')
 check(s:start(4,1,0,'PineValley',true,'Normal',{[4]=true,[5]=true}),'Start private party')
 check(not s:join(6,1,1),'Uninvited player cannot join private party')
 check(s:join(5,1,1),'Invited player joins private party')
 check(s.queues[1].launchAt==nil and #s:due(100)==0,'Private party also waits indefinitely')
 check(s:lockIn(5,101) and s.queues[1].launchAt==104,'Full private party gets three seconds')
 check(s:unready(5,103) and #s:due(104)==0,'Last-second unready blocks launch')
 check(s:lockIn(5,105) and s.queues[1].launchAt==108,'Re-ready restarts three seconds')
 check(#s:due(108)==1,'Private launch when everyone ready')
 s:finish(1)
 check(s.membership[4]==nil and s.membership[5]==nil,'Finish clears every membership')
 check(s.queues[1].launchAt==nil and s:picking(1)==0,'Finish clears readiness/countdown')
 return {passed=checks,failed=0}
end
return T
