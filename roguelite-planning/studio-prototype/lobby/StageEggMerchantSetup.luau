--!nonstrict
-- Stages the egg merchant install inside Studio so it runs WITHOUT the repo's HTTP server:
--   1. ServerStorage.EggMerchantSetup: a ModuleScript holding InstallEggMerchant, both install-data
--      tables and the uploaded texture/icon ids. After the 3D Import of
--      blender-egg-merchant-kit/exports/fbx/egg-merchant-studio.fbx, run in the command bar:
--        require(game.ServerStorage.EggMerchantSetup)()
--   2. (watch=true) An auto-install: when the importer drops the `egg-merchant-studio` model into
--      Workspace, wait for all 22 meshes, then run the setup once and print the report. Lives in the
--      Studio MCP plugin's state, so it is gone after a Studio restart (then use the command above).
-- Run (repo served on localhost):
--   loadstring(HS:GetAsync(".../studio-prototype/lobby/StageEggMerchantSetup.luau"))()(".../", true)
local IDS = {
	eggTexture = "rbxassetid://140294240008480", -- textures/egg-kit-baked.png
	merchantTexture = "rbxassetid://130996618550776", -- textures/merchant-baked.png
	icon = "rbxassetid://117887028525234", -- previews/icon-egg.png
}
return function(base, watch)
	base = base or "http://127.0.0.1:8857/"
	local HS = game:GetService("HttpService")
	local SS = game:GetService("ServerStorage")
	local function get(path)
		return HS:GetAsync(base .. path, true)
	end
	local installer = get("studio-prototype/lobby/InstallEggMerchant.luau")
	local egg = get("blender-egg-merchant-kit/studio-install-data-egg.json")
	local merchant = get("blender-egg-merchant-kit/studio-install-data-merchant.json")
	assert(not egg:find("]==]", 1, true) and not merchant:find("]==]", 1, true), "data would break the long string")
	local source = table.concat({
		"-- Generated by studio-prototype/lobby/StageEggMerchantSetup.luau. Run after the 3D Import of",
		"-- blender-egg-merchant-kit/exports/fbx/egg-merchant-studio.fbx:  require(game.ServerStorage.EggMerchantSetup)()",
		"local HS = game:GetService('HttpService')",
		"local EGG = HS:JSONDecode([==[" .. egg .. "]==])",
		"local MER = HS:JSONDecode([==[" .. merchant .. "]==])",
		"local install = (function()",
		installer,
		"end)()",
		"return function()",
		string.format(
			" return install(nil, {egg = EGG, merchant = MER, eggTexture = %q, merchantTexture = %q, icon = %q})",
			IDS.eggTexture,
			IDS.merchantTexture,
			IDS.icon
		),
		"end",
	}, "\n")
	assert(loadstring(source), "generated setup does not compile")
	local m = SS:FindFirstChild("EggMerchantSetup") or Instance.new("ModuleScript")
	m.Name = "EggMerchantSetup"
	pcall(function()
		m.Sandboxed = false
	end)
	m.Source = source
	m.Parent = SS
	local report = { "ServerStorage.EggMerchantSetup written (" .. #source .. " chars)" }

	if watch then
		if _G.EggMerchantImportWatch then
			_G.EggMerchantImportWatch:Disconnect()
		end
		local busy = false
		local function try(model)
			if busy or not string.find(string.lower(model.Name), "egg%-merchant%-studio") then
				return
			end
			busy = true
			task.spawn(function()
				-- The importer adds the model first and its meshes as they upload.
				for _ = 1, 240 do
					local n = 0
					for _, d in model:GetDescendants() do
						if d:IsA("MeshPart") and (d.Name:find("^Egg_") or d.Name:find("^Pedestal_") or d.Name:find("^Merchant_")) then
							n += 1
						end
					end
					if n >= 22 then
						break
					end
					task.wait(0.5)
				end
				task.wait(1)
				local ok, result = pcall(function()
					return require(m:Clone())()
				end)
				print("[EggMerchant] auto-install after import:", ok, result)
				if ok and _G.EggMerchantImportWatch then
					_G.EggMerchantImportWatch:Disconnect()
					_G.EggMerchantImportWatch = nil
				end
				busy = false
			end)
		end
		_G.EggMerchantImportWatch = workspace.ChildAdded:Connect(try)
		table.insert(report, "watching Workspace for the egg-merchant-studio import")
	end
	return table.concat(report, "\n")
end
